# Placeholder template only: COPY outside Git and chmod 0600. NEVER commit actual values.
APP_DOMAIN=app.example.com
CRM_DOMAIN=crm.example.com
ACME_EMAIL=ops@example.com
# Set a long random password, URL-encoded if needed in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_ME
# DATABASE_URL must match postgres service and POSTGRES_PASSWORD; do not log it.
DATABASE_URL=postgresql+psycopg://autoforce:REPLACE_ME@postgres:5432/autoforce
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
WORKER_SECRET=REPLACE_WITH_DISTINCT_32_RANDOM_BYTES
CRM_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_FROM_SECRET_MANAGER
# Genesis service secrets (distinct from AutoForceAI JWT/worker; no shared cookie/JWT).
MONGO_ROOT_USERNAME=REPLACE_WITH_MONGO_ROOT_USERNAME
MONGO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# URL-encode password characters in this URI; use authSource=admin.
GENESIS_MONGODB_URI=mongodb://REPLACE_WITH_MONGO_ROOT_USERNAME:REPLACE_WITH_URL_ENCODED_PASSWORD@mongo:27017/genesis_crm?authSource=admin
GENESIS_JWT_SECRET=REPLACE_WITH_DISTINCT_32_RANDOM_BYTES
GENESIS_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
GENESIS_MAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_GENESIS_ENCRYPTION_KEY
# Optional provider keys; blank is safe; rotate previously disclosed keys before use.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# Public HTTPS ingress DNS must already resolve to this server.
CORS_ALLOWED_ORIGINS=https://app.example.com
GENESIS_CORS_ORIGIN=https://crm.example.com
GENESIS_TRACKING_BASE_URL=https://crm.example.com
