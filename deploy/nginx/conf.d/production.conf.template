server {
    listen 80;
    server_name ${APP_DOMAIN} ${CRM_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/includes/tls.conf;
    client_max_body_size 26m;
    client_body_timeout 30s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # No WebSocket/HMR proxy endpoints in production.
    location ~ ^/(?:_next/webpack-hmr|sockjs-node|__vite_ping)(?:/|$) { return 404; }
    location ~ ^/(?:api/|auth/|health$|uploads/|widget/) {
        proxy_pass http://backend:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade "";
    }
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade "";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CRM_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${CRM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CRM_DOMAIN}/privkey.pem;
    include /etc/nginx/includes/tls.conf;
    client_max_body_size 26m;
    client_body_timeout 30s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    location ~ ^/(?:_next/webpack-hmr|sockjs-node|__vite_ping)(?:/|$) { return 404; }
    location / {
        proxy_pass http://genesis-web:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade "";
    }
}
