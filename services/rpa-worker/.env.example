# .env.example
GEO_SERVER_URL=http://localhost:8010/api/v1
RPA_HEADLESS=false
WORKER_ID=worker_01
# Set the same strong, private WORKER_SECRET in the API and worker environments.
WORKER_SECRET=

# Platform specific credentials
ZHIHU_COOKIE=your_zhihu_cookie_here
ZHIHU_USERNAME=your_username
ZHIHU_PASSWORD=your_password

# WordPress REST (preferred over browser RPA)
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WP_DEFAULT_STATUS=draft
WP_ADMIN_URL=
