# ============================================================
# AutoForceAI Digital Brain - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- Service ----------
# Backend listening port (frontend NEXT_PUBLIC_API_URL must match this)
PORT=8010
# Set to "true" for verbose debug logging
DEBUG=false

# ---------- Database ----------
# Default (dev): SQLite, zero configuration required.
# Production: uncomment DATABASE_URL for PostgreSQL (pgvector required for RAG).
# DATABASE_URL=postgresql://user:password@localhost:5432/autoforce
DB_USER=geo
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo

# ---------- Security ----------
# APP_ENV=production requires a strong JWT_SECRET and explicit HTTPS CORS allowlist.
APP_ENV=development
JWT_SECRET=
# CORS_ALLOWED_ORIGINS=https://console.example.com
# Production rate limiting needs a verified shared gateway/Redis or a single worker.
# RATE_LIMIT_SHARED_ENFORCED=1
# RATE_LIMIT_SINGLE_PROCESS=1
# CRM service token 加密密钥。必须是 Fernet.generate_key() 生成的 32-byte urlsafe-base64 key，
# 不接受普通口令；一旦使用后请通过密钥管理器持久化，不得提交到 Git。
CRM_CREDENTIAL_ENCRYPTION_KEY=
# Allow open email registration (first registered user becomes system admin)
ALLOW_EMAIL_REGISTER=true

# ---------- LLM Provider Keys ----------
# These are global fallbacks. Per-model keys configured in 模型纳管 UI take precedence.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# ---------- GEO / Search ----------
# H-07 web_search uses Serper's fixed HTTPS endpoint https://google.serper.dev/search.
# Leave unset to return SEARCH_NOT_CONFIGURED; do not put keys in source control or tool params.
SERPER_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEO_SCHEDULER_INTERVAL=60

# ---------- H-10 alerts ----------
# Resolved alerts are deleted by the CRM worker daily after this many days (1..3650).
ALERT_RETENTION_DAYS=90
# Alert webhook/email is deliberately NOT supported: arbitrary destinations risk SSRF
# and leaking organization data. Leave all ALERT_WEBHOOK_URL, ALERT_EMAIL_TO and
# ALERT_NOTIFICATIONS_ENABLED unset; enabling causes worker startup to fail closed.

# ---------- WordPress (independent site publishing) ----------
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WP_DEFAULT_STATUS=draft

# ---------- WeChat OAuth (optional; falls back to mock login when unset) ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
