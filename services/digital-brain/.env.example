# ============================================================
# AutoForceAI Digital Brain - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- Service ----------
# Backend listening port (frontend NEXT_PUBLIC_API_URL must match this)
PORT=8010
# Set to "true" for verbose debug logging
DEBUG=false

# ---------- Database ----------
# Default (dev): SQLite, zero configuration required.
# Production: uncomment DATABASE_URL for PostgreSQL (pgvector required for RAG).
# DATABASE_URL=postgresql://user:password@localhost:5432/autoforce
DB_USER=geo
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo

# ---------- Security ----------
# JWT signing secret. MUST be overridden with a long random string in production.
JWT_SECRET=please-change-this-to-a-long-random-string
# Allow open email registration (first registered user becomes system admin)
ALLOW_EMAIL_REGISTER=true

# ---------- LLM Provider Keys ----------
# These are global fallbacks. Per-model keys configured in 模型纳管 UI take precedence.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# ---------- GEO / Search ----------
SERPER_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEO_SCHEDULER_INTERVAL=60

# ---------- WordPress (independent site publishing) ----------
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WP_DEFAULT_STATUS=draft

# ---------- WeChat OAuth (optional; falls back to mock login when unset) ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
